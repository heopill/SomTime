    "seatPracticeTip %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right after tapping a seat, %@. Moving to the button often takes longer than picking the seat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "座席をタップしたら、すぐに%@。座席を選ぶより、ボタンまで指を動かすほうが時間がかかることが多いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좌석을 누른 직후 %@ 옮겨 보세요. 좌석 고르기보다 버튼까지 가는 시간이 더 걸리는 경우가 많아요."
          }
        }
      }
